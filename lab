# =============================================================================
#  lab - the control CLI for k8s-kubeadm-lab (macOS / Linux hosts)
#
#  Everything you do to the cluster goes through this one command. It reads
#  lab.env, copies the node scripts over SSH, and runs them in the right order
#  on the right machines.
#
#      ./lab help
#
#  Windows hosts: use  windows\lab.ps1  which mirrors these commands.
# =============================================================================
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/scripts/lib/common.sh"

REMOTE_DIR="/tmp/k8s-lab"

# --- Config ------------------------------------------------------------------
need_env() {
  if [ ! -f "${SELF_DIR}/lab.env" ]; then
    err "No lab.env found."
    info "Create one and fill in your IPs:"
    info "    cp lab.env.example lab.env && \${EDITOR:-vi} lab.env"
    exit 1
  fi
  # shellcheck disable=SC1091
  . "${SELF_DIR}/lab.env"
  export LAB_ROOT="$SELF_DIR"
  parse_workers
  # Guard: an empty WORKERS list must not trip `set -u` later.
  WORKER_NAMES=("${WORKER_NAMES[@]:-}"); WORKER_IPS=("${WORKER_IPS[@]:-}")
  [ -z "${WORKER_NAMES[0]:-}" ] && { WORKER_NAMES=(); WORKER_IPS=(); }
  : "${SSH_USER:?SSH_USER must be set in lab.env}"
  : "${CP_IP:?CP_IP must be set in lab.env}"
  : "${CP_NAME:=k8s-cp}"
  : "${SSH_PORT:=22}"
  : "${SSH_KEY:=}"
  : "${K8S_MINOR:=v1.31}"
  : "${CNI:=calico}"
  : "${POD_CIDR:=192.168.0.0/16}"
  : "${SERVICE_CIDR:=10.96.0.0/12}"
  : "${REMOTE_BACKUP_DIR:=/opt/etcd-backups}"
  : "${LOCAL_BACKUP_DIR:=${SELF_DIR}/backups}"
  : "${BACKUP_RETENTION:=7}"
}

# --- SSH plumbing ------------------------------------------------------------
# macOS still ships bash 3.2, so this stays free of mapfile/readarray.
SSH_OPTS=()
build_ssh_opts() {
  local key="${SSH_KEY/#\~/$HOME}"
  SSH_OPTS=(-o BatchMode=yes
            -o StrictHostKeyChecking=accept-new
            -o UserKnownHostsFile="${SELF_DIR}/.known_hosts"
            -o ConnectTimeout=10
            -p "${SSH_PORT}")
  if [ -n "${SSH_KEY:-}" ] && [ -f "$key" ]; then SSH_OPTS+=(-i "$key"); fi
}

# rsh <ip> <command...>  - run a command on a node
rsh() {
  local ip="$1"; shift
  build_ssh_opts
  ssh "${SSH_OPTS[@]}" "${SSH_USER}@${ip}" "$@"
}

# rsudo <ip> <env-assignments> <command...> - run as root with env passed through
rsudo() {
  local ip="$1" envs="$2"; shift 2
  rsh "$ip" "sudo ${envs} bash -c $(printf '%q' "$*")"
}

rcopy_to() {
  build_ssh_opts
  scp "${SSH_OPTS[@]}" -q -r "$1" "${SSH_USER}@${2}:${3}"
}
rcopy_from() {
  build_ssh_opts
  scp "${SSH_OPTS[@]}" -q "${SSH_USER}@${1}:${2}" "$3"
}

# all_nodes - echoes "name ip role" lines for every node in the lab
all_nodes() {
  echo "${CP_NAME} ${CP_IP} control-plane"
  local i
  [ "${#WORKER_NAMES[@]}" -eq 0 ] && return 0
  for i in "${!WORKER_NAMES[@]}"; do
    echo "${WORKER_NAMES[$i]} ${WORKER_IPS[$i]} worker"
  done
}

# resolve_node <name-or-ip-or-'cp'> - print the IP
resolve_node() {
  local q="$1"
  case "$q" in cp|control-plane|"${CP_NAME}"|"${CP_IP}") echo "$CP_IP"; return;; esac
  local i
  for i in "${!WORKER_NAMES[@]}"; do
    if [ "$q" = "${WORKER_NAMES[$i]}" ] || [ "$q" = "${WORKER_IPS[$i]}" ]; then
      echo "${WORKER_IPS[$i]}"; return
    fi
  done
  # Allow a bare index: worker1 -> first worker
  case "$q" in
    worker|worker1|w1) [ "${#WORKER_IPS[@]}" -gt 0 ] && { echo "${WORKER_IPS[0]}"; return; };;
  esac
  die "Unknown node '${q}'. Known: ${CP_NAME} ${WORKER_NAMES[*]:-}"
}

# hosts_block - the /etc/hosts lines every node should carry
hosts_block() {
  local out="${CP_IP} ${CP_NAME}"
  local i
  [ "${#WORKER_NAMES[@]}" -eq 0 ] && { printf '%s' "$out"; return 0; }
  for i in "${!WORKER_NAMES[@]}"; do
    out="${out}\n${WORKER_IPS[$i]} ${WORKER_NAMES[$i]}"
  done
  printf '%s' "$out"
}

# sync_scripts <ip> - push the node scripts to a machine
sync_scripts() {
  local ip="$1"
  rsh "$ip" "rm -rf ${REMOTE_DIR} && mkdir -p ${REMOTE_DIR}" \
    || die "Cannot SSH to ${SSH_USER}@${ip}. Try: ./lab ssh-setup"
  rcopy_to "${SELF_DIR}/scripts" "$ip" "${REMOTE_DIR}/"
  rsh "$ip" "chmod +x ${REMOTE_DIR}/scripts/node/*.sh ${REMOTE_DIR}/scripts/lib/*.sh"
}

# node_env - the env string handed to every node script
node_env() {
  printf 'K8S_MINOR=%q K8S_PKG_VERSION=%q CNI=%q POD_CIDR=%q SERVICE_CIDR=%q ' \
    "$K8S_MINOR" "${K8S_PKG_VERSION:-}" "$CNI" "$POD_CIDR" "$SERVICE_CIDR"
  printf 'CALICO_VERSION=%q FLANNEL_VERSION=%q CILIUM_VERSION=%q ' \
    "${CALICO_VERSION:-v3.28.2}" "${FLANNEL_VERSION:-v0.25.6}" "${CILIUM_VERSION:-1.16.3}"
  printf 'METRICS_SERVER_VERSION=%q ETCDCTL_VERSION=%q ASSUME_YES=%q ' \
    "${METRICS_SERVER_VERSION:-v0.7.2}" "${ETCDCTL_VERSION:-v3.5.16}" "${ASSUME_YES:-0}"
}

# =============================================================================
#  Commands
# =============================================================================

cmd_help() {
cat <<'EOF'
lab - control CLI for the kubeadm lab

  SETUP
    ./lab check              Validate lab.env and SSH reachability of every node
    ./lab ssh-setup          Create an SSH key and install it on all nodes
    ./lab preflight          Run read-only readiness checks on every node

  BUILD
    ./lab up                 Full build: prep -> init -> CNI -> join -> verify
    ./lab prep               Prepare every node (swap, sysctl, containerd, kube tools)
    ./lab init               kubeadm init + CNI + add-ons on the control plane
    ./lab join [node]        Join a worker (default: all workers)
    ./lab addons             Install metrics-server, local-path, helm, etcdctl

  OPERATE
    ./lab status             One-screen cluster overview
    ./lab verify             Full health check incl. a live smoke test
    ./lab kubeconfig         Fetch admin.conf so kubectl works from THIS machine
    ./lab ssh <node>         Interactive SSH into a node (cp | worker1 | <name>)
    ./lab run <node|all> ..  Run an arbitrary command on one or all nodes
    ./lab kubectl <args...>  Run kubectl on the control plane

  BACKUP / RESTORE
    ./lab backup [label]     Snapshot etcd and pull the file to ./backups
    ./lab backups            List snapshots on the control plane and locally
    ./lab restore [file]     Restore etcd (default: newest snapshot on the CP)
    ./lab dr-drill           Guided disaster-recovery exercise (backup, break, restore)

  TROUBLESHOOT / TEARDOWN
    ./lab diagnostics        Collect a support bundle from every node into ./diagnostics
    ./lab reset [node|all]   kubeadm reset a node back to a clean state
    ./lab labs               List the hands-on exercises in ./labs

  Config lives in lab.env (copy it from lab.env.example).
EOF
}

cmd_check() {
  need_env
  section "Configuration"
  info "control plane : ${CP_NAME} (${CP_IP})"
  local i
  for i in "${!WORKER_NAMES[@]}"; do
    info "worker        : ${WORKER_NAMES[$i]} (${WORKER_IPS[$i]})"
  done
  info "ssh           : ${SSH_USER}@... port ${SSH_PORT} key ${SSH_KEY:-<agent/password>}"
  info "kubernetes    : ${K8S_MINOR}${K8S_PKG_VERSION:+ pinned ${K8S_PKG_VERSION}}"
  info "cni / podCIDR : ${CNI} / ${POD_CIDR}"

  section "Local tooling"
  local missing_tool=0
  for c in ssh scp; do
    if command -v "$c" >/dev/null 2>&1; then ok "$c found"; else err "$c missing"; missing_tool=1; fi
  done
  command -v kubectl >/dev/null 2>&1 && ok "kubectl found ($(kubectl version --client -o json 2>/dev/null | grep -m1 gitVersion | cut -d'"' -f4))" \
    || warn "kubectl not installed locally - './lab kubectl' still works over SSH"

  section "Node reachability"
  local failed=0
  while read -r name ip role; do
    printf '  %-16s %-16s %-14s ' "$name" "$ip" "$role"
    if rsh "$ip" "echo ok" >/dev/null 2>&1; then
      local remote_host; remote_host="$(rsh "$ip" hostname 2>/dev/null)"
      if [ "$remote_host" = "$name" ]; then
        printf '%sSSH ok%s (hostname matches)\n' "$C_GREEN" "$C_RESET"
      else
        printf '%sSSH ok%s (hostname is "%s", expected "%s")\n' "$C_YELLOW" "$C_RESET" "$remote_host" "$name"
      fi
    else
      printf '%sunreachable%s\n' "$C_RED" "$C_RESET"; failed=1
    fi
  done < <(all_nodes)

  echo
  if [ "$failed" = 1 ]; then
    err "At least one node is unreachable over SSH."
    info "Fix with: ./lab ssh-setup   (or check the IPs in lab.env)"
    exit 1
  fi
  [ "$missing_tool" = 1 ] && exit 1
  ok "Everything checks out. Next: ./lab preflight"
}

cmd_ssh_setup() {
  need_env
  local key="${SSH_KEY/#\~/$HOME}"
  [ -n "$key" ] || die "Set SSH_KEY in lab.env first."
  section "SSH key"
  if [ -f "$key" ]; then
    skip "Key already exists: ${key}"
  else
    mkdir -p "$(dirname "$key")"
    ssh-keygen -t ed25519 -N '' -C "k8s-lab@$(hostname)" -f "$key"
    ok "Created ${key}"
  fi

  section "Installing the public key on each node"
  info "You will be asked for the ${SSH_USER} password once per node."
  while read -r name ip _; do
    echo
    log "${name} (${ip})"
    if command -v ssh-copy-id >/dev/null 2>&1; then
      ssh-copy-id -p "${SSH_PORT}" -i "${key}.pub" \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="${SELF_DIR}/.known_hosts" \
        "${SSH_USER}@${ip}" && ok "Key installed on ${name}"
    else
      ssh -p "${SSH_PORT}" -o StrictHostKeyChecking=accept-new "${SSH_USER}@${ip}" \
        "mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys" \
        < "${key}.pub" && ok "Key installed on ${name}"
    fi
  done < <(all_nodes)

  echo
  ok "Done. Verify with: ./lab check"
}

cmd_preflight() {
  need_env
  local peers; peers="$(all_nodes | awk '{print $2}' | tr '\n' ' ')"
  local rc=0
  while read -r name ip role; do
    section "Preflight: ${name} (${ip}, ${role})"
    sync_scripts "$ip"
    rsudo "$ip" "ROLE=${role} PEER_IPS='${peers}'" \
      "${REMOTE_DIR}/scripts/node/01-preflight.sh" || rc=1
  done < <(all_nodes)
  echo
  [ "$rc" -eq 0 ] && ok "All nodes passed preflight. Next: ./lab up" \
                  || die "Preflight failed on at least one node - fix the FAILs above."
}

cmd_prep() {
  need_env
  local hb; hb="$(hosts_block)"
  while read -r name ip role; do
    section "Preparing ${name} (${ip}, ${role})"
    sync_scripts "$ip"
    rsudo "$ip" "$(node_env) NODE_NAME=${name} ROLE=${role} HOSTS_ENTRIES=$(printf '%q' "$hb") FIREWALL_MODE=${FIREWALL_MODE:-open-ports} SSH_PORT_ON_NODE=${SSH_PORT}" \
      "${REMOTE_DIR}/scripts/node/02-prep-node.sh" || die "prep failed on ${name}"
    rsudo "$ip" "$(node_env)" "${REMOTE_DIR}/scripts/node/03-install-containerd.sh" || die "containerd failed on ${name}"
    rsudo "$ip" "$(node_env)" "${REMOTE_DIR}/scripts/node/04-install-kube-tools.sh" || die "kube tools failed on ${name}"
    ok "${name} prepared"
  done < <(all_nodes)
  echo
  ok "Every node is prepared. Next: ./lab init"
}

cmd_init() {
  need_env
  section "Initialising the control plane on ${CP_NAME} (${CP_IP})"
  sync_scripts "$CP_IP"
  rsudo "$CP_IP" "$(node_env) NODE_NAME=${CP_NAME} APISERVER_IP=${CP_IP} ALLOW_CP_WORKLOADS=${ALLOW_CP_WORKLOADS:-0}" \
    "${REMOTE_DIR}/scripts/node/10-init-control-plane.sh" || die "kubeadm init failed"

  section "Installing the pod network (${CNI})"
  rsudo "$CP_IP" "$(node_env)" "${REMOTE_DIR}/scripts/node/11-install-cni.sh" || die "CNI install failed"

  cmd_kubeconfig
  echo
  ok "Control plane is up. Next: ./lab join"
}

cmd_addons() {
  need_env
  section "Installing add-ons on ${CP_NAME}"
  sync_scripts "$CP_IP"
  rsudo "$CP_IP" "$(node_env) WITH_METRICS=${WITH_METRICS:-1} WITH_LOCALPATH=${WITH_LOCALPATH:-1} WITH_HELM=${WITH_HELM:-1} WITH_ETCDCTL=${WITH_ETCDCTL:-1}" \
    "${REMOTE_DIR}/scripts/node/13-install-addons.sh"
}

cmd_join() {
  need_env
  local target="${1:-all}"
  section "Fetching a fresh join command from ${CP_NAME}"
  local join_cmd
  join_cmd="$(rsudo "$CP_IP" "" "kubeadm token create --print-join-command" 2>/dev/null | grep '^kubeadm join')"
  [ -n "$join_cmd" ] || die "Could not get a join command. Is the control plane initialised?"
  ok "Token issued (valid 24h)"

  local i joined=0
  for i in "${!WORKER_NAMES[@]}"; do
    local name="${WORKER_NAMES[$i]}" ip="${WORKER_IPS[$i]}"
    if [ "$target" != "all" ] && [ "$target" != "$name" ] && [ "$target" != "$ip" ]; then continue; fi
    section "Joining ${name} (${ip})"
    sync_scripts "$ip"
    rsudo "$ip" "ASSUME_YES=${ASSUME_YES:-1} NODE_IP=${ip} JOIN_CMD=$(printf '%q' "$join_cmd")" \
      "${REMOTE_DIR}/scripts/node/12-join-worker.sh" || die "join failed on ${name}"
    joined=$((joined+1))
  done
  [ "$joined" -gt 0 ] || die "No matching worker for '${target}'."

  section "Waiting for nodes to report Ready"
  local n=0
  while [ "$n" -lt 40 ]; do
    if ! rsudo "$CP_IP" "" "KUBECONFIG=/etc/kubernetes/admin.conf kubectl get nodes --no-headers" 2>/dev/null | grep -qv ' Ready'; then
      break
    fi
    sleep 10; n=$((n+1))
  done
  cmd_kubectl get nodes -o wide
  echo
  ok "Workers joined. Next: ./lab verify"
}

cmd_up() {
  need_env
  section "Building the whole lab"
  info "This runs preflight -> prep -> init -> CNI -> add-ons -> join -> verify."
  info "Expect 10-20 minutes on a typical home LAN."
  confirm "Start?" || { info "Aborted."; exit 0; }
  cmd_preflight
  cmd_prep
  cmd_init
  cmd_addons
  cmd_join all
  cmd_verify
  echo
  ok "Lab is ready. Try:  ./lab status   then  ./lab labs"
}

cmd_verify() {
  need_env
  sync_scripts "$CP_IP"
  rsudo "$CP_IP" "SMOKE=${SMOKE:-1}" "${REMOTE_DIR}/scripts/node/20-verify-cluster.sh"
}

cmd_kubectl() {
  need_env
  local quoted="" a
  for a in "$@"; do quoted="${quoted} $(printf '%q' "$a")"; done
  rsudo "$CP_IP" "" "KUBECONFIG=/etc/kubernetes/admin.conf kubectl${quoted}"
}

cmd_kubeconfig() {
  need_env
  local dest="${SELF_DIR}/kubeconfig"
  section "Fetching kubeconfig"
  rsudo "$CP_IP" "" "cat /etc/kubernetes/admin.conf" > "$dest" 2>/dev/null \
    || die "Could not read admin.conf on the control plane."
  [ -s "$dest" ] || die "Fetched an empty kubeconfig."
  # admin.conf points at the advertise address already, but a cluster built with
  # a different name/IP would break here, so normalise it.
  sed -i.bak -E "s|server: https://[^:]+:6443|server: https://${CP_IP}:6443|" "$dest" && rm -f "${dest}.bak"
  chmod 600 "$dest"
  ok "Wrote ${dest}"
  info "Use it from this machine with:"
  info "  export KUBECONFIG=${dest}"
  info "  kubectl get nodes"
}

cmd_status() {
  need_env
  section "Nodes"
  cmd_kubectl get nodes -o wide 2>/dev/null | sed 's/^/  /' || { err "API server unreachable"; exit 1; }
  section "System pods"
  cmd_kubectl get pods -n kube-system -o wide 2>/dev/null | sed 's/^/  /'
  section "Workloads (all namespaces)"
  cmd_kubectl get deploy,sts,ds -A 2>/dev/null | sed 's/^/  /'
  section "Problems"
  local bad
  bad="$(cmd_kubectl get pods -A --no-headers 2>/dev/null | grep -vE 'Running|Completed' || true)"
  [ -z "$bad" ] && ok "No unhealthy pods" || { warn "Unhealthy pods:"; sed 's/^/    /' <<<"$bad"; }
  section "Recent events"
  cmd_kubectl get events -A --sort-by=.lastTimestamp 2>/dev/null | tail -12 | sed 's/^/  /'
}

cmd_backup() {
  need_env
  local label="${1:-}"
  section "Taking an etcd snapshot on ${CP_NAME}"
  sync_scripts "$CP_IP"
  rsudo "$CP_IP" "BACKUP_DIR=${REMOTE_BACKUP_DIR} RETENTION=${BACKUP_RETENTION} LABEL=$(printf '%q' "$label")" \
    "${REMOTE_DIR}/scripts/node/30-etcd-backup.sh" || die "Backup failed"

  section "Pulling the snapshot to this machine"
  mkdir -p "$LOCAL_BACKUP_DIR"
  local newest
  newest="$(rsudo "$CP_IP" "" "ls -1t ${REMOTE_BACKUP_DIR}/etcd-snapshot-*.db | head -1" | tr -d '\r')"
  [ -n "$newest" ] || die "No snapshot found on the control plane."
  # The files are root-owned 0600, so stage a readable copy first.
  rsudo "$CP_IP" "" "cp ${newest} ${newest}.sha256 ${newest}.meta /tmp/ && chown ${SSH_USER} /tmp/$(basename "$newest")*"
  local base; base="$(basename "$newest")"
  for suffix in "" ".sha256" ".meta"; do
    rcopy_from "$CP_IP" "/tmp/${base}${suffix}" "${LOCAL_BACKUP_DIR}/" || true
  done
  rsudo "$CP_IP" "" "rm -f /tmp/${base}*"
  if command -v shasum >/dev/null 2>&1 && [ -f "${LOCAL_BACKUP_DIR}/${base}.sha256" ]; then
    local want have
    want="$(cut -d' ' -f1 < "${LOCAL_BACKUP_DIR}/${base}.sha256")"
    have="$(shasum -a 256 "${LOCAL_BACKUP_DIR}/${base}" | cut -d' ' -f1)"
    [ "$want" = "$have" ] && ok "Checksum verified after transfer" || die "Checksum mismatch after transfer!"
  fi
  ok "Local copy: ${LOCAL_BACKUP_DIR}/${base}"
  ls -lh "${LOCAL_BACKUP_DIR}" | sed 's/^/  /'
}

cmd_backups() {
  need_env
  section "On the control plane (${REMOTE_BACKUP_DIR})"
  rsudo "$CP_IP" "" "ls -lh ${REMOTE_BACKUP_DIR}/etcd-snapshot-*.db 2>/dev/null || echo '  (none)'" | sed 's/^/  /'
  section "Local (${LOCAL_BACKUP_DIR})"
  ls -lh "${LOCAL_BACKUP_DIR}"/*.db 2>/dev/null | sed 's/^/  /' || info "(none)"
}

cmd_restore() {
  need_env
  local snap="${1:---latest}"
  section "Restoring etcd on ${CP_NAME}"
  sync_scripts "$CP_IP"

  # A local file path means "upload this snapshot, then restore from it".
  if [ -f "$snap" ]; then
    local base; base="$(basename "$snap")"
    info "Uploading ${base} to the control plane"
    rcopy_to "$snap" "$CP_IP" "/tmp/${base}"
    [ -f "${snap}.sha256" ] && rcopy_to "${snap}.sha256" "$CP_IP" "/tmp/${base}.sha256"
    rsudo "$CP_IP" "" "mkdir -p ${REMOTE_BACKUP_DIR} && mv /tmp/${base}* ${REMOTE_BACKUP_DIR}/ && chown root:root ${REMOTE_BACKUP_DIR}/${base}*"
    snap="${REMOTE_BACKUP_DIR}/${base}"
  fi

  rsudo "$CP_IP" "ASSUME_YES=${ASSUME_YES:-0} BACKUP_DIR=${REMOTE_BACKUP_DIR}" \
    "${REMOTE_DIR}/scripts/node/31-etcd-restore.sh $(printf '%q' "$snap")" || die "Restore failed"
  echo
  ok "Restore finished. Verifying..."
  cmd_kubectl get nodes
}

cmd_dr_drill() {
  need_env
  cat <<'EOF'

  DISASTER-RECOVERY DRILL
  =======================
  This walks the full backup -> destroy -> restore cycle on your live lab.
  It will:
    1. Deploy a marker workload  (namespace: dr-drill)
    2. Take a labelled etcd snapshot
    3. Delete the namespace, simulating an accidental `kubectl delete`
    4. Restore etcd from the snapshot
    5. Prove the workload came back

EOF
  confirm "Run the drill?" || { info "Aborted."; exit 0; }

  section "1/5  Create the marker workload"
  cmd_kubectl create namespace dr-drill 2>/dev/null || true
  cmd_kubectl -n dr-drill create deployment marker --image=nginx:stable-alpine --replicas=2 2>/dev/null || true
  cmd_kubectl -n dr-drill rollout status deploy/marker --timeout=180s
  cmd_kubectl get all -n dr-drill

  section "2/5  Snapshot etcd"
  cmd_backup "dr-drill"

  section "3/5  Simulate the disaster"
  warn "Deleting namespace dr-drill..."
  cmd_kubectl delete namespace dr-drill --wait=true
  cmd_kubectl get namespace dr-drill 2>&1 | sed 's/^/  /' || true
  err "The workload is gone. This is the moment your backup matters."

  section "4/5  Restore"
  ASSUME_YES=1 cmd_restore --latest

  section "5/5  Verify recovery"
  sleep 15
  if cmd_kubectl get deploy -n dr-drill marker >/dev/null 2>&1; then
    cmd_kubectl get all -n dr-drill
    echo
    ok "DRILL PASSED - the deleted namespace came back from the snapshot."
    info "Clean up when you are done:  ./lab kubectl delete ns dr-drill"
  else
    err "DRILL FAILED - dr-drill did not come back."
    info "Investigate with: ./lab diagnostics"
    exit 1
  fi
}

cmd_diagnostics() {
  need_env
  local out="${SELF_DIR}/diagnostics"
  mkdir -p "$out"
  while read -r name ip role; do
    section "Collecting from ${name} (${ip})"
    sync_scripts "$ip"
    local tar
    tar="$(rsudo "$ip" "OUT_DIR=/tmp" "${REMOTE_DIR}/scripts/node/99-diagnostics.sh" | grep -oE '/tmp/diagnostics-[^ ]+\.tar\.gz' | head -1)"
    if [ -n "$tar" ]; then
      rsudo "$ip" "" "chown ${SSH_USER} ${tar}"
      rcopy_from "$ip" "$tar" "$out/" && ok "Saved $(basename "$tar")"
      rsudo "$ip" "" "rm -f ${tar}"
    else
      warn "No bundle produced on ${name}"
    fi
  done < <(all_nodes)
  echo
  ls -lh "$out" | sed 's/^/  /'
  ok "Bundles in ${out}/"
}

cmd_reset() {
  need_env
  local target="${1:-}"
  [ -n "$target" ] || die "Usage: ./lab reset <node|all>"
  echo
  warn "This destroys the Kubernetes installation on: ${target}"
  confirm "Are you sure?" || { info "Aborted."; exit 0; }

  if [ "$target" = "all" ]; then
    # Workers first, control plane last, so the cluster degrades cleanly.
    local i
    for i in "${!WORKER_NAMES[@]}"; do
      section "Resetting ${WORKER_NAMES[$i]}"
      sync_scripts "${WORKER_IPS[$i]}"
      rsudo "${WORKER_IPS[$i]}" "ASSUME_YES=1 PURGE_PACKAGES=${PURGE_PACKAGES:-0}" \
        "${REMOTE_DIR}/scripts/node/90-reset-node.sh"
    done
    section "Resetting ${CP_NAME}"
    sync_scripts "$CP_IP"
    rsudo "$CP_IP" "ASSUME_YES=1 PURGE_PACKAGES=${PURGE_PACKAGES:-0}" \
      "${REMOTE_DIR}/scripts/node/90-reset-node.sh"
  else
    local ip; ip="$(resolve_node "$target")"
    sync_scripts "$ip"
    rsudo "$ip" "ASSUME_YES=1 PURGE_PACKAGES=${PURGE_PACKAGES:-0}" \
      "${REMOTE_DIR}/scripts/node/90-reset-node.sh"
  fi
  echo
  ok "Reset complete. Rebuild with: ./lab up"
}

cmd_ssh() {
  need_env
  local ip; ip="$(resolve_node "${1:-cp}")"
  local key="${SSH_KEY/#\~/$HOME}"
  local opts=(-o StrictHostKeyChecking=accept-new
              -o UserKnownHostsFile="${SELF_DIR}/.known_hosts"
              -p "${SSH_PORT}")
  [ -n "${SSH_KEY:-}" ] && [ -f "$key" ] && opts+=(-i "$key")
  exec ssh "${opts[@]}" "${SSH_USER}@${ip}"
}

cmd_run() {
  need_env
  local target="${1:?Usage: ./lab run <node|all> <command...>}"; shift
  [ $# -gt 0 ] || die "Usage: ./lab run <node|all> <command...>"
  if [ "$target" = "all" ]; then
    while read -r name ip _; do
      section "${name} (${ip})"
      rsh "$ip" "$@"
    done < <(all_nodes)
  else
    rsh "$(resolve_node "$target")" "$@"
  fi
}

cmd_labs() {
  section "Hands-on exercises in ./labs"
  local d
  for d in "${SELF_DIR}"/labs/*/; do
    [ -d "$d" ] || continue
    local name; name="$(basename "$d")"
    local title; title="$(head -3 "${d}README.md" 2>/dev/null | grep -m1 '^# ' | sed 's/^# //')"
    printf '  %s%-28s%s %s\n' "$C_BOLD" "$name" "$C_RESET" "${title:-}"
  done
  echo
  info "Start one with:  cat labs/01-workloads/README.md"
  info "Each lab has a verify.sh you can run to check your work."
}

# =============================================================================
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    help|-h|--help) cmd_help ;;
    check)          cmd_check ;;
    ssh-setup)      cmd_ssh_setup ;;
    preflight)      cmd_preflight ;;
    prep)           cmd_prep ;;
    init)           cmd_init ;;
    addons)         cmd_addons ;;
    join)           cmd_join "$@" ;;
    up)             cmd_up ;;
    verify)         cmd_verify ;;
    status)         cmd_status ;;
    kubeconfig)     cmd_kubeconfig ;;
    kubectl|k)      cmd_kubectl "$@" ;;
    backup)         cmd_backup "$@" ;;
    backups)        cmd_backups ;;
    restore)        cmd_restore "$@" ;;
    dr-drill)       cmd_dr_drill ;;
    diagnostics)    cmd_diagnostics ;;
    reset)          cmd_reset "$@" ;;
    ssh)            cmd_ssh "$@" ;;
    run)            cmd_run "$@" ;;
    labs)           cmd_labs ;;
    *) err "Unknown command: ${cmd}"; echo; cmd_help; exit 1 ;;
  esac
}
main "$@"
