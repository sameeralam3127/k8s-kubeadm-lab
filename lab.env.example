# =============================================================================
# k8s-kubeadm-lab configuration
# -----------------------------------------------------------------------------
# Copy this file to `lab.env` and edit the values for your environment:
#     cp lab.env.example lab.env
#
# `lab.env` is git-ignored, so your IPs and usernames stay local.
# Every script in this repo reads this one file - there is nothing else to edit.
# =============================================================================

# --- Nodes -------------------------------------------------------------------
# Hostname and IP of the control-plane VM (the one on your Mac).
CP_NAME="k8s-cp"
CP_IP="192.168.1.101"

# Worker nodes. Space-separated list of "name:ip" pairs.
# One worker is enough to start; add more as you grow the lab.
#   WORKERS="k8s-worker1:192.168.1.102 k8s-worker2:192.168.1.103"
WORKERS="k8s-worker1:192.168.1.102"

# --- SSH ---------------------------------------------------------------------
# The Linux user you created during the Ubuntu install. Must have sudo rights.
SSH_USER="ubuntu"
# Private key used to reach the VMs. Run `./lab ssh-setup` to create and push one.
SSH_KEY="$HOME/.ssh/k8s-lab"
SSH_PORT="22"

# --- Kubernetes --------------------------------------------------------------
# Minor version series for the apt repo (pkgs.k8s.io publishes per-minor repos).
K8S_MINOR="v1.31"
# Exact package version to pin. Leave empty to take the newest in K8S_MINOR.
# Find valid values with: apt-cache madison kubeadm
K8S_PKG_VERSION=""

# --- Networking --------------------------------------------------------------
# CNI plugin: calico | flannel | cilium
CNI="calico"
# Pod CIDR. Must match the CNI:
#   calico  -> 192.168.0.0/16
#   flannel -> 10.244.0.0/16
#   cilium  -> 10.0.0.0/16
POD_CIDR="192.168.0.0/16"
SERVICE_CIDR="10.96.0.0/12"

# Component versions (pinned so the lab is reproducible)
CALICO_VERSION="v3.28.2"
FLANNEL_VERSION="v0.25.6"
CILIUM_VERSION="1.16.3"
METRICS_SERVER_VERSION="v0.7.2"
ETCDCTL_VERSION="v3.5.16"

# --- Security ----------------------------------------------------------------
# How the node firewall is handled during `./lab prep`:
#   open-ports  (default) enable ufw and open only the ports Kubernetes needs
#   disable               turn ufw off entirely (lab shortcut, not a habit)
#   leave                 do not touch the firewall; you manage it yourself
FIREWALL_MODE="open-ports"

# --- Backups -----------------------------------------------------------------
# Where snapshots land on the control plane, and where `./lab backup` pulls them.
REMOTE_BACKUP_DIR="/opt/etcd-backups"
LOCAL_BACKUP_DIR="./backups"
# How many snapshots to keep on the control plane before pruning old ones.
BACKUP_RETENTION="7"
